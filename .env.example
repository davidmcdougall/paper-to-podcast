# ── Required ────────────────────────────────────────────────────────────────
# Get your Anthropic API key at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Get your ElevenLabs API key at https://elevenlabs.io -> Profile -> API Keys
# Needs a PAID plan: the free plan can't use Voice Library voices via the API.
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# ── Podcast identity ─────────────────────────────────────────────────────────
# Name your podcast — this appears in the RSS feed and podcast apps
PODCAST_TITLE=My Research Podcast
PODCAST_DESCRIPTION=Academic papers turned into podcast episodes.
PODCAST_AUTHOR=Your Name

# ── Claude models ──────────────────────────────────────────────────────────
# Discover newest Sonnet/Haiku available to your key; never switch families.
# Set explicit model IDs to pin behavior/cost instead.
TEXT_MODEL=auto
FAST_MODEL=auto
# Optional additional writing models; choosing one also controls the summary pass.
TEXT_MODEL_OPTIONS=
# Used only with auto. No cross-family fallback is allowed.
TEXT_MODEL_FAMILY=sonnet
FAST_MODEL_FAMILY=haiku

# ── Optional: ElevenLabs voice ───────────────────────────────────────────────
# Leave blank to use the first voice in your account
# To pick a specific voice: ElevenLabs dashboard → Voices → copy the voice ID
ELEVENLABS_VOICE_ID=

# ── Optional: Obsidian ───────────────────────────────────────────────────────
# Full path to your Obsidian vault folder — saves a Zettelkasten note per episode
# Example: ~/Library/Mobile Documents/iCloud~md~obsidian/Documents/Research
OBSIDIAN_VAULT_PATH=

# ── Optional: Cloudflare R2 (podcast feed) ───────────────────────────────────
# Without R2, audio is stored locally and you can listen via the web UI.
# With R2, episodes are uploaded and an RSS feed is published — subscribe once
# in any podcast app and new episodes appear automatically.
#
# Setup: https://developers.cloudflare.com/r2/get-started/
#   1. Create an R2 bucket (see current R2 pricing for storage and operation allowances)
#   2. Enable public access and note your public URL
#   3. Create an API token with Object Read & Write on your bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_KEY=
R2_BUCKET=paper-to-podcast
R2_PUBLIC_URL=
